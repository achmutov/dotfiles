for arg in "$@"; do
  if [[ "$arg" =~ ^git@(.*):(.*)$ ]] || [[ "$arg" =~ ^https://(.*)/(.*)$ ]]; then
    # shellcheck disable=SC2154
    host="${match[1]}"
    rpath="${match[2]}"
    rpath="${rpath%/}"
    rpath="${rpath%.git}"
    printf '%s\n' "${host}/${rpath}"
    return
  fi
done
return 1

